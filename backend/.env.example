# ============================================================
#  copy this file to .env and fill in the real values.
#  on render, add each of these in  Environment -> Environment Variables
#  NEVER commit the real .env file.
# ============================================================

# ---- basic ----
# render sets PORT by itself, no need to add it there
PORT=9000
# must be exactly "production" on render, otherwise the login cookie
# will not be sent across domains and nobody can stay logged in
NODE_ENV=development

# ---- addresses ----
# the frontend address. on render put your vercel url here, no slash at the end.
# more than one is allowed, separate them with a comma
FRONTEND_URL=http://localhost:5173
# this backend's own address, used for the paypal return url
BACKEND_URL=http://localhost:9000

# ---- database ----
# local:  mongodb://127.0.0.1:27017/ecommerce
# atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/ecommerce
MONGODB_URI=mongodb://127.0.0.1:27017/ecommerce

# ---- login token ----
# a long random string. make one with:  openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_long_random_string
# how many HOURS the login cookie stays valid
JWT_TOKEN_EXPIRY=24

# ---- first admin account (created once on the first boot) ----
ADMIN_USERNAME=adminuser
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_CONTACT_NUMBER=9999999999

# ---- email (gmail needs an App Password, not your normal password) ----
NODEMAILER_HOST=smtp.gmail.com
NODEMAILER_PORT=587
NODEMAILER_SECURE=false
NODEMAILER_EMAIL=yourmail@gmail.com
NODEMAILER_PASSWORD=your_16_char_app_password

# ---- cloudinary (product images) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- paypal (optional, leave empty to stay on Cash on Delivery) ----
# PAYPAL_MODE=sandbox
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
